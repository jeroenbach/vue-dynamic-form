{
  "private": true,
  "description": "A playground for testing the vue-dynamic-form library with Storybook. This lives outside the workspace.",
  "scripts": {
    "check-updates": "pnpm dlx npm-check-updates -i --format group",
    "dev": "pnpm storybook",
    "storybook": "storybook dev -p 6006 --no-open",
    "build": "storybook build -c ./.output/",
    "serve": "pnpm dlx http-server ./.output/ -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "ci:test": "TZ=Europe/Amsterdam vitest run",
    "typecheck": "vue-tsc --noEmit",
    "ci:typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@bach.software/vue-dynamic-form": "link:../../packages/core",
    "@bach.software/vue-dynamic-form-starter": "link:../../packages/starter",
    "@vee-validate/i18n": "^4.15.1",
    "@vee-validate/rules": "^4.15.1",
    "@vue/shared": "3.5.44",
    "vee-validate": "4.15.1",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "4.1.0",
    "@storybook/addon-a11y": "9.1.2",
    "@storybook/vue3": "9.1.2",
    "@storybook/vue3-vite": "9.1.2",
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "24.2.1",
    "@vitejs/plugin-vue": "6.0.1",
    "@vitest/browser": "3.2.4",
    "@vitest/coverage-v8": "3.2.4",
    "playwright": "1.54.2",
    "storybook": "9.1.2",
    "tailwindcss": "4.1.12",
    "typescript": "5.9.2",
    "vite": "7.1.2",
    "vite-plugin-vue-devtools": "8.0.0",
    "vitest-plugin": "link:@storybook/addon-vitest/vitest-plugin",
    "vue-tsc": "3.0.5"
  }
}
